{
  "name": "api",
  "version": "0.0.1",
  "description": "Ravex API",
  "scripts": {
    "build": "nest build",
    "start:dev": "echo \"TODO: Configure NestJS dev start\"",
    "typeorm": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js --dataSource ormconfig.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/%npm_config_name%",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.0",
    "cache-manager-redis-store": "^3.0.1",
    "connect-redis": "^7.0.0",
    "dotenv": "^16.0.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "pg": "^8.10.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/express-rate-limit": "^6.0.0",
    "@types/express-session": "^1.17.7",
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
